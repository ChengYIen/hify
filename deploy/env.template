# Hify Docker Compose environment template.
# Copy to .env, then replace all example values before deployment.
# External service hosts must be reachable from containers; do not use localhost.
# For local acceptance on Docker Desktop, use host.docker.internal to reach services on the host.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=3

MYSQL_HOST=10.0.0.10
MYSQL_PORT=3306
MYSQL_DATABASE=hify
MYSQL_USER=hify
MYSQL_PASSWORD=change-me

PG_HOST=10.0.0.11
PG_PORT=5432
PG_DATABASE=hify
PG_USER=hify
PG_PASSWORD=change-me

REDIS_HOST=10.0.0.12
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=change-me

HIFY_UPLOAD_DIR=/var/lib/hify/upload
HIFY_VERSION=local
FRONTEND_EXPOSE_PORT=8080
BACKEND_EXPOSE_PORT=8081
JWT_SECRET=replace-with-a-random-secret

# Provider API keys are currently managed and encrypted in Hify's database.
# Keep future environment-based provider secrets in this file only.
