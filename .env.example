# Hify external service connection settings.
# Copy this file to .env and replace every placeholder before deployment.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=3

MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_DATABASE=hify
MYSQL_USER=hify
MYSQL_PASSWORD=change-me

PG_HOST=postgres.example.internal
PG_PORT=5432
PG_DATABASE=hify
PG_USER=hify
PG_PASSWORD=change-me

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=change-me

# Use a host path for JAR/systemd deployment, or keep the container path for Docker.
HIFY_UPLOAD_DIR=/var/lib/hify/upload

# Docker published ports.
HIFY_VERSION=local
FRONTEND_EXPOSE_PORT=8080
BACKEND_EXPOSE_PORT=8081

# JWT signing secret used by the backend.
JWT_SECRET=replace-with-a-random-secret

# Provider API keys are currently managed and encrypted in Hify's database.
# Keep any future environment-based provider secrets in this file only;
# never pass them to the frontend service.
