apiVersion: v1
kind: Secret
metadata:
  name: hify-secret
type: Opaque
stringData:
  MYSQL_USER: "hify"
  MYSQL_PASSWORD: "replace-me"
  PG_USER: "hify"
  PG_PASSWORD: "replace-me"
  REDIS_PASSWORD: "replace-me"
  OPENAI_API_KEY: "replace-with-openai-api-key"
  JWT_SECRET: "replace-with-a-random-secret"
